# ---------------------------------------------------------------------------
# klique — environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# MongoDB connection string.
#  - Local:  mongodb://127.0.0.1:27017/klique
#  - Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/klique?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/klique

# Secret used to sign login tokens (JWT). Use at least 32 random characters:
#   openssl rand -base64 48
AUTH_SECRET=

# Public URL of the web app. Used to build share links (WhatsApp) and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the API as seen by clients.
# Leave EMPTY for the web app (same origin). A future mobile/desktop app sets
# this to the deployed API origin, e.g. https://api.klique.ng
NEXT_PUBLIC_API_URL=

# Extra origins allowed to call the API from a browser (comma separated).
# Needed only if a separate web/desktop client is served from another origin.
# Native mobile apps do not need CORS. Example: https://app.klique.ng,http://localhost:5173
ALLOWED_ORIGINS=

# Login token lifetime in days.
SESSION_DAYS=30

# ---------------------------------------------------------------------------
# Cloudinary: three separate accounts (free tier is fine). Uploads go straight
# from the app to Cloudinary using short-lived signatures from /api/uploads/sign,
# so the secrets never reach a browser, phone or desktop client.
# Leave a block empty to turn that kind of upload off.
# ---------------------------------------------------------------------------
# Profile pictures
CLOUDINARY_AVATARS_CLOUD_NAME=
CLOUDINARY_AVATARS_API_KEY=
CLOUDINARY_AVATARS_API_SECRET=
# Photos: topic pictures, community covers, pictures in chat
CLOUDINARY_PHOTOS_CLOUD_NAME=
CLOUDINARY_PHOTOS_API_KEY=
CLOUDINARY_PHOTOS_API_SECRET=
# Videos: topic videos
CLOUDINARY_VIDEOS_CLOUD_NAME=
CLOUDINARY_VIDEOS_API_KEY=
CLOUDINARY_VIDEOS_API_SECRET=

# ---------------------------------------------------------------------------
# Voice rooms: LiveKit Cloud (free "Build" plan: 5,000 participant-minutes a month).
# Create a project at https://cloud.livekit.io and copy these three values.
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Password given to the demo accounts created by `npm run seed` (dev only).
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Realtime (Ably): instant chat, DMs, unread dots and live topic comments.
# Free plan at https://ably.com: create an app, then copy its API key
# (Settings -> API keys; the key looks like  appId.keyId:secret).
# SERVER ONLY: never expose it to the browser. Leave empty and the app simply
# polls instead (slower, but everything still works).
# ---------------------------------------------------------------------------
ABLY_API_KEY=

# ---------------------------------------------------------------------------
# Cache + shared rate limits: Upstash Redis (free plan).
# https://upstash.com -> Create database -> open it -> "REST API" section ->
# copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Leave empty and each server process keeps its own small in-memory cache
# (fine for development; with several servers, set these so limits are shared).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Email (verification, password reset): any SMTP service. Free options:
#  - Brevo   https://brevo.com   300 emails/day. Settings -> SMTP & API -> SMTP.
#            Host smtp-relay.brevo.com, port 587; user = your login, pass = the SMTP key.
#            Verify your sender address first (Senders & IP).
#  - Resend  https://resend.com  host smtp.resend.com, port 465, user "resend", pass = API key
#            (needs a domain you own to email other people).
#  - Gmail   smtp.gmail.com, port 465, an App Password (testing only).
# MAIL_FROM must be an address the service lets you send from.
# Leave SMTP_HOST empty and emails are printed in the server console instead
# (handy in development: copy the link from there). Email verification is only
# enforced once SMTP is configured.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="klique. <no-reply@yourdomain.com>"

# ---------------------------------------------------------------------------
# "Continue with Google".
# https://console.cloud.google.com -> create a project -> APIs & Services ->
# OAuth consent screen (External, add your email) -> Credentials -> Create
# credentials -> OAuth client ID -> Web application. Add this Authorised
# redirect URI (must match NEXT_PUBLIC_APP_URL exactly):
#     http://localhost:3000/api/auth/google/callback
# (and the same path on your real domain once deployed). Copy the two values.
# Leave empty and the Google buttons simply don't appear.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mobile app "Continue with Google": extra addresses the app may be sent back to
# (comma separated). "klique://auth" always works. While developing in Expo Go
# add the address `expo start` shows, e.g. exp://192.168.1.5:8081/--/auth
NATIVE_REDIRECT_URIS=

# --- Phone notifications (mobile app) ---------------------------------------
# Pushes go through Expo's free push service; no key is needed to send.
# Only set this if you enable "Enhanced push security" in your Expo account:
# EXPO_ACCESS_TOKEN=
# "Starts soon" reminders: call GET /api/cron/reminders every 10-15 minutes from a free
# scheduler (cron-job.org) with ?secret=<this value>. Make up a long random string.
# The same secret guards GET /api/cron/media-cleanup (once a night; deletes unused Cloudinary uploads,
# add &dry=1 to preview), and GET /api/cron/event-sources (once a night; checks the event finder's
# source pages and adds new events to the /admin inbox as pending). On Vercel, vercel.json already
# schedules both and sends the secret itself.
CRON_SECRET=

# --- Admin & hosting ----------------------------------------------------------
# Comma-separated emails of site admins: they open /admin (reports, event inbox, hosts) and can post
# public events that aren't tied to a community.
ADMIN_EMAILS=
# Owners of a community with at least this many members can post public events too (default 100).
EVENT_HOST_MIN_MEMBERS=100
